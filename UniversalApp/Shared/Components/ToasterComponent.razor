<div class="alert @(Type == "danger" ? "alert-error" :
                  Type == "success" ? "alert-success" :
                  Type == "warn" ? "alert-warning" : "")">
    <svg xmlns="http://www.w3.org/2000/svg"
         class="h-6 w-6 shrink-0 stroke-current"
         fill="none"
         viewBox="0 0 24 24">
        <path stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="@(Type == "danger" ? "M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" :
                        Type == "success" ? "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" :
                        Type == "warn" ? "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" : "")" />
    </svg>
    <span>@Message</span>

    @if (Redirect)
    {
        <a href="@Url" class="ml-auto">
            <button class="btn btn-sm">Go to @Location</button>
        </a>
    }
</div>

@code {
    [Parameter] public string Message { get; set; }
    [Parameter] public string Type { get; set; }

    [Parameter] public bool Redirect { get; set; }
    [Parameter] public string Location { get; set; }
    [Parameter] public string Url { get; set; }
}
