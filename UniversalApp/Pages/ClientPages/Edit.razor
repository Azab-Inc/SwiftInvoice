@page "/clients/edit/{Id:int}"
@using UniversalApp.Models;
@using UniversalApp.Services;
@using UniversalApp.Shared.Components;
@using Microsoft.AspNetCore.Components.Forms;
@using Microsoft.AspNetCore.Components.Web;
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<h1 class="page-heading">Manage Client</h1>

@if (currentClient != null)
{
    <EditForm Model="currentClient" OnValidSubmit="HandleSaveChanges">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="flex flex-col md:flex-row sm:gap-x-2">
            <div class="w-full sm:w-1/2">
                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <InputText id="firstName" class="form-control" @bind-Value="currentClient.FirstName" />
                </div>

                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <InputText id="lastName" class="form-control" @bind-Value="currentClient.LastName" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="currentClient.Email" />
                </div>

                <div class="form-group">
                    <label for="phone">Phone</label>
                    <InputText id="phone" class="form-control" @bind-Value="currentClient.Phone" />
                </div>
            </div>

            <div class="w-full sm:w-1/2">
                <div class="flex flex-row gap-x-1 items-center justify-start">
                    <label class="tooltip" data-tip="Is this invoice for another business?" for="isB2B">Is B2B</label>
                    <InputCheckbox id="isB2B" class="checkbox w-4 checkbox-[pri]" @bind-Value="currentClient.isB2B" />
                </div>
                <div class="form-group">
                    <label for="businessNumber">Business Number</label>
                    <InputText id="businessNumber" class="form-control" @bind-Value="currentClient.BusinessNumber" />
                </div>

                <div class="form-group">
                    <label for="businessName">Business Name</label>
                    <InputText id="businessName" class="form-control" @bind-Value="currentClient.BusinessName" />
                </div>

                <div class="form-group">
                    <label for="website">Website</label>
                    <InputText id="website" class="form-control" @bind-Value="currentClient.Website" />
                </div>

                <div class="form-group">
                    <label for="profileImg">Profile Image</label>
                    <InputFile id="profileImg" class="form-control" OnChange="HandleFileUpload" />
                    @if (uploadError != null)
                    {
                        <p class="text-red-500">@uploadError</p>
                    }
                </div>

                <div class="form-group">
                    @if (!string.IsNullOrWhiteSpace(currentClient.ProfileImg))
                    {
                        <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(File.ReadAllBytes(currentClient.ProfileImg))}")"
                             alt="Profile Image" class="w-full object-contain" />
                    }
                    else if (previewImage != null)
                    {
                        <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(previewImage)}")"
                             alt="Image Preview" class="w-full object-contain" />
                    }
                    else
                    {
                        <p>No profile image available.</p>
                    }
                </div>
            </div>
        </div>

        @if (deleteClient)
        {
            @if (canDeleteClient)
            {
                <ToasterComponent Message="Are you sure you want to delete this client?" Type="danger" Redirect="false" Location="" Url="" />
                <button @onclick:preventDefault="true" @onclick="ConfirmDeleteClient" class="btn btn-danger mt-3">Confirm delete</button>
            }
            else
            {
                <ToasterComponent Message="This client is still linked to some invoices" Type="danger" Redirect="false" Location="" Url="" />
                
            }

    }

        @if (confirmSave)
        {
            <ToasterComponent Message="Are you sure you want to save changes to this client?" Type="warn" Redirect="false" Location="" Url="" />
            <button @onclick:preventDefault="true" @onclick="ConfirmSaveChanges" class="btn btn-warn mt-3">Confirm save</button>
        }

        @if (!savedChanges && !confirmSave && !deleteClient)
        {
            <div class="flex flex-row mt-3 gap-3">
                <button @onclick:preventDefault="true" @onclick="StartSaveChangesConfirmation" class="btn btn-warn">Save changes</button>
                <button @onclick:preventDefault="true" @onclick="StartDeleteClientConfirmation" class="btn btn-danger">Delete Client</button>
            </div>
        }
    </EditForm>
}
else
{
    <p>Client not found</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private User currentUser = new User();
    private UserService userService = new UserService();

    private Client currentClient = new Client();
    private ClientService clientService = new ClientService();

    private InvoiceService invoiceService = new InvoiceService();

    private IBrowserFile uploadedFile;
    private byte[] previewImage;

    private string uploadError;
    private bool savedChanges = false;
    private bool deleteClient = false;
    private bool canDeleteClient = false;
    private bool confirmSave = false;

    private bool hasPreview = false; // Add this state variable

    protected override void OnInitialized()
    {
        currentUser = userService.dbLoadUser();
        currentClient = clientService.dbGetSingle(currentUser.UserId, Id);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;

        if (uploadedFile.Size > 512 * 1024)
        {
            uploadError = "File size exceeds the limit of 512 KB.";
            previewImage = null;
            hasPreview = false;
            return;
        }

        uploadError = null;

        using (var stream = uploadedFile.OpenReadStream())
        {
            using (var memoryStream = new MemoryStream())
            {
                await stream.CopyToAsync(memoryStream);
                previewImage = memoryStream.ToArray();
            }
        }

        hasPreview = true; // Set hasPreview to true to trigger a re-render
        StateHasChanged();
    }

    private async Task HandleSaveChanges()
    {
        if (uploadedFile != null)
        {
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var safeFirstName = string.IsNullOrEmpty(currentClient.FirstName) ? "Unknown" : currentClient.FirstName.Replace(" ", "_");
            var safeLastName = string.IsNullOrEmpty(currentClient.LastName) ? "Unknown" : currentClient.LastName.Replace(" ", "_");

            var newFileName = $"{timestamp}_{safeFirstName}_{safeLastName}_{currentClient.Id}{Path.GetExtension(uploadedFile.Name)}";

            var folderPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "SwiftInvoice", "ClientProfiles");
            Directory.CreateDirectory(folderPath);

            var filePath = Path.Combine(folderPath, newFileName);

            using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await uploadedFile.OpenReadStream().CopyToAsync(fileStream);
            }

            currentClient.ProfileImg = filePath;
        }

        clientService.dbEdit(currentUser.UserId, currentClient);

        savedChanges = true;
        confirmSave = false;

        // Reset preview after saving
        previewImage = null;
        hasPreview = false;
        StateHasChanged();
    }

    private void StartDeleteClientConfirmation()
    {
        deleteClient = true;

        @if (invoiceService.dbGetNumClientInvoices(currentUser.UserId, currentClient.Id) == 0)
        {
            canDeleteClient = true;
        }

    confirmSave = false;
    }

    private void StartSaveChangesConfirmation()
    {
        confirmSave = true;
        deleteClient = false;
    }

    private void ConfirmDeleteClient()
    {
        clientService.dbDelete(currentUser.UserId, currentClient);
        NavigationManager.NavigateTo("/clients");
    }

    private void ConfirmSaveChanges()
    {
        HandleSaveChanges();
    }
}
