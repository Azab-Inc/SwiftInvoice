@page "/clients"

@using UniversalApp.Models;
@using UniversalApp.DTOs;
@using UniversalApp.Services;
@using UniversalApp.DTOs.ClientDTOs;
@using UniversalApp.Shared.Components;

<h1 class="page-heading">All Clients</h1>

<a href="/clients/create"><button class="btn-pri ml-auto">Add Client</button></a>
<div class="my-3 flex flex-col sm:flex-row gap-1">
    <input type="text" @bind="searchTerm" placeholder="Search clients..." class="input input-bordered" />
    <a><button @onclick="() => OnSearch()" class="btn-pri ml-auto">Search</button></a>
</div>

<div class="grid place-content-center place-items-center grid-cols-1 lg:grid-cols-2  gap-3 my-3 mx-auto">
    
    @if (clients != null && clients.Any())
    {
        @foreach (ClientPreviewDTO client in clients)
        {
            <CardComponent>
                <h3><b>Client: </b>@client.FirstName @client.LastName</h3>
                <div class="flex flex-col gap-1 lg:flex-row">
                    <p><b>Email:</b> @client.Email</p>
                    <p><b>Phone:</b> @client.Phone</p>
                </div>

                @if (!string.IsNullOrEmpty(client.ProfileImg))
                {
                    <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(File.ReadAllBytes(client.ProfileImg))}")"
                         alt="Profile Image" class="w-full h-40 object-contain" />
                }
                else
                {
                    <p>No profile image available.</p>
                }

                <div class="flex flex-col-reverse sm:flex-row gap-3 items-center sm:items-end justify-between mt-3">
                    <a href="/clients/edit/@client.Id">
                        <button class="btn btn-pri">Manage Client</button>
                    </a>
                    <p><b>Invoices:</b> @client.Invoices</p>
                </div>
            </CardComponent>
        }
    }
    else
    {
        <p>No clients found.</p>
    }
</div>


@code {
    private ClientService clientService = new ClientService();
    private UserService userService = new UserService();
    private InvoiceService invoiceService = new InvoiceService();
    private List<ClientPreviewDTO> clients = new List<ClientPreviewDTO>();
    private User currentUser = new User();
    private string searchTerm = string.Empty;


    protected override void OnInitialized()
    {
        currentUser = userService.dbLoadUser();

        clients = clientService.dbGetManyDTO(currentUser.UserId, 20, 0, client =>
        {

            int numInvoices = invoiceService.dbGetNumClientInvoices(currentUser.UserId, client.Id);
            return ClientMapper.MapClientToDTO(client, numInvoices);
        });
    }

    private void OnSearch()
    {
        clients = clientService.dbSearch(currentUser.UserId, searchTerm);
    }
}
