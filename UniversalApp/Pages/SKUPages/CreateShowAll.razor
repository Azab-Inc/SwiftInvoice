
@page "/skus"
@using UniversalApp.Models;
@using UniversalApp.DTOs;
@using UniversalApp.Services;
@using UniversalApp.Shared.Components;
@using Microsoft.AspNetCore.Components.Forms;
@using Microsoft.AspNetCore.Components.Web;

<h1 class="page-heading">Create SKU</h1>

<EditForm Model="newSKU" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="flex flex-col sm:flex-row gap-x-2 my-3">
        <div class="form-group">
            <label for="firstName">SKU Name</label>
            <input type="text" class="input input-bordered w-full max-w-xs" @bind-value="newSKU.SKUName" />
        </div>
        <button type="submit" class="mx-auto mt-auto sm:btn btn-success text-xl h-fit btn-wide" disabled="@(newSKU == null)">Create</button> 
    </div>

    @if (alreadyExists == true && successCreate == false)
    {
        <ToasterComponent Message="SKU already exists!" Type="danger" Redirect="false" Location="" Url="" />
    }
</EditForm>

<table class="mx-auto w-full whitespace-normal">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Connected Invoices</th>
            <th></th>
        </tr>
    </thead>
    <tbody class="whitespace-nowrap">
        @if (currentSKUs.Any())
        {
            @foreach (SKUTableDTO sku in currentSKUs)
            {
                <tr>
                    <td>@sku.Id</td>
                    @if (editMode && sku.Id == currentEditSkuId)
                    {
                        <td><input type="text" class="input input-bordered w-full max-w-xs" @bind-value="newSkuName" /></td>
                    }
                    else
                    {
                        <td>@(string.IsNullOrEmpty(sku.SKUName) ? "Missing Name" : sku.SKUName)</td>

                    }
                    <td>@sku.numInvoices</td>
                    <td class="flex gap-x-1">
                        @if (!string.IsNullOrEmpty(sku.SKUName))
                        {
                            @if (editMode && sku.Id == currentEditSkuId)
                            {
                                <button @onclick="SaveEdit" class="btn btn-success">Save</button>
                                <button @onclick="CancelEdit" class="btn btn-error">Cancel</button>
                            }
                            else
                            {
                                <button @onclick="() => HandleEdit(sku)" class="btn btn-warning">Edit</button>
                                @if (sku.numInvoices == 0)
                                {
                                    <button @onclick="() => HandleDelete(sku)" class="btn btn-error">Delete</button>
                                }
                            }
                        }
                        else
                        {
                            <span>No operations available</span> <!-- Placeholder to avoid empty <td> -->
                        }
                    </td>

                </tr>
            }
        }
    </tbody>
</table>

@code {
    private SKUService SKUService = new SKUService();
    private SKU newSKU = new SKU();
    private List<SKUTableDTO> currentSKUs = new List<SKUTableDTO>();
    private List<SKU> tmpSKUs = new List<SKU>();

    private User currentUser = new User();
    private UserService userService = new UserService();

    private InvoiceService invoiceService = new InvoiceService();

    private bool alreadyExists = false;
    private bool successCreate = false;
    private bool deletedBanned = false;
    private bool editMode = false;

    private int currentEditSkuId = 0;

    private string newSkuName = "";

    protected override void OnInitialized()
    {
        currentUser = userService.dbLoadUser();
        loadSKUs();
    }

    void HandleValidSubmit()
    {
        alreadyExists = SKUService.alreadyExists(currentUser.UserId, newSKU.SKUName);

        if (!alreadyExists)
        {
            SKUService.dbCreate(currentUser.UserId, newSKU);
            successCreate = true;
            loadSKUs();
            newSKU = new SKU(); 
        }
    }

    void HandleEdit(SKUTableDTO skuDTO)
    {
        currentEditSkuId = skuDTO.Id;
        newSkuName = SKUService.dbGetSingle(currentUser.UserId, currentEditSkuId).SKUName;
        editMode = true;
    }

    void SaveEdit()
    {
        try
        {
            alreadyExists = SKUService.alreadyExists(currentUser.UserId, newSkuName);

        }
        catch
        {
            alreadyExists = false;
        }

        if (!alreadyExists)
        {            
            SKU skuToEdit = SKUService.dbGetSingle(currentUser.UserId, currentEditSkuId);

            skuToEdit.SKUName = newSkuName;
            SKUService.dbEdit(currentUser.UserId, skuToEdit);


            editMode = false;
            currentEditSkuId = 0;
            loadSKUs();
        }


    }

    void CancelEdit()
    {
        editMode = false;
        currentEditSkuId = 0;
        loadSKUs(); 
    }

    void HandleDelete(SKUTableDTO skuDTO)
    {
        SKU sku = new SKU
        {
            Id = skuDTO.Id,
            SKUName = skuDTO.SKUName,
            UserId = skuDTO.UserId
        };

        if (invoiceService.dbGetNumSkuInvoices(currentUser.UserId, sku.Id) == 0)
        {
            SKUService.dbDelete(currentUser.UserId, sku);
            loadSKUs(); 
        }
    }

    void loadSKUs()
    {
        currentSKUs = new List<SKUTableDTO>();
        tmpSKUs = SKUService.dbGetMany(currentUser.UserId, SKUService.dbGetCount(currentUser.UserId), 0);

        foreach (SKU sku in tmpSKUs)
        {
            int numInvoices = invoiceService.dbGetNumSkuInvoices(currentUser.UserId, sku.Id);
            SKUTableDTO sKUTableDTO = new SKUTableDTO(sku.Id, sku.SKUName, numInvoices, currentUser.UserId);
                        
            currentSKUs.Add(sKUTableDTO);
        }
    }
}