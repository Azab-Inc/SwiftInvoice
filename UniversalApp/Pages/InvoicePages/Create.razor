@page "/newinvoice"
@using UniversalApp.Models;
@using UniversalApp.DTOs;
@using UniversalApp.DTOs.ClientDTOs;
@using UniversalApp.Services;
@using UniversalApp.Shared.Components;
@using Microsoft.AspNetCore.Components.Forms

<h1 class="page-heading">New Invoice</h1>

<EditForm Model="newInvoice" OnValidSubmit="SaveInvoice">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="flex flex-col md:flex-row md:gap-x-2">
        <div class="md:w-2/5">
            <label>
                <span>SKU Type:</span>
                @if (skuOptions.Count > 0)
                {
                    <select class="select select-bordered border-[1px] p-1 border-pri min-w-20" 
                            
                            @onchange="OnSkuSelected"> 
                        @foreach (SKU sku in skuOptions)
                        {
                            <option value="@sku.Id">@sku.SKUName</option>
                        }
                    </select>
                }
                else
                {
                    <h2>No SKUs found, please add one.</h2>
                }
            </label>
            <label>
                <span>Invoice Number:</span>
                <span>@invoiceNumber</span> 
            </label>
            <label>
                <span>Client name:</span> 
                <div>
                    @if (clientOptions.Count > 0)
                    {
                        <select class="select select-bordered border-[1px] p-1 border-pri max-w-48" name="client-name" @bind="newInvoice.ClientId">
                            @foreach (ClientNameSetDTO clientNameSet in clientOptions)
                            {
                                <option class="border-[1px] p-1 border-pri" value="@clientNameSet.Id">
                                    @if (clientNameSet.isB2B == true)
                                    {
                                        @clientNameSet.BusinessName
                                    }
                                    else
                                    {
                                        @clientNameSet.FirstName @clientNameSet.LastName
                                    }
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <h2>No clients found, please add one.</h2>
                    }
                </div>
            </label>
            <label>
                <span>Job name:</span>
                <input @bind="newInvoice.JobName" name="job-name" type="text" />
            </label>
            <hr />
            <label>
                <span>START date:</span>
                <InputDate @bind-Value="newInvoice.StartDate" format="dd/MM/yyyy" />
            </label>
            <label>
                <span>END date:</span>
                <InputDate @bind-Value="newInvoice.EndDate" format="dd/MM/yyyy" />
            </label>
            <label>
                <span>PAYMENT date:</span>
                <InputDate @bind-Value="newInvoice.PaymentDate" format="dd/MM/yyyy" />
            </label>
            <label>
                <span>CREATED date:</span>
                <InputDate @bind-Value="newInvoice.CreatedDate" format="dd/MM/yyyy" />
            </label>
        </div>
        <div class="md:w-2/5">
            <label class="flex flex-col">
                <span>Job Description: </span>
                <textarea @bind="newInvoice.JobDescription" name="job-description" rows="10" cols="25"></textarea>
            </label>
        </div>
    </div>
    <hr />
    <div>
        @foreach (Item item in invoiceItems)
        {
            <div class="w-full flex flex-col p-3 border-pri border-2 rounded-md mt-3 mx-auto">
                <div class="w-full flex md:flex-row flex-col gap-3">
                    <div class="flex flex-col w-1/5">
                        <span>Item name:</span>
                        <input class="border-2 border-pri rounded-sm p-3" @bind="item.Name" type="text" />
                    </div>
                    <div class="flex flex-col w-3/5">
                        <span>Description: </span>
                        <textarea class="border-2 border-pri rounded-sm p-3" @bind="item.Description" rows="2" cols="10"></textarea>
                    </div>
                    <div class="flex flex-col w-1/5">
                        <span>Price: </span>
                        <input class="border-2 border-pri rounded-sm p-3" @bind="item.Price" type="number" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-danger" @onclick:preventDefault="true" @onclick="(() => RemoveItem(item))">Remove item</button>
                </div>
            </div>
        }

        <div>
            @if (bankAccounts.Count > 0)
            {
                <h2>Account Payable</h2>
                <select name="bank-account" @bind="@selectedAccount.AccountId">
                    @foreach (BankAccount bankAccount in bankAccounts)
                    {
                        <option value="@bankAccount.AccountId">@bankAccount.BankName</option>
                    }
                </select>
            }
            else
            {
                <h2>No bank accounts found, please add one.</h2>
            }
        </div>

        <div class="mt-3">
            <button class="btn btn-sec" @onclick:preventDefault="true" @onclick="AddItem">Add item</button>
        </div>
    </div>
</EditForm>

@if (!createdInvoice)
{
    <button class="btn-suc text-xl px-4 py-2" @onclick="SaveInvoice">Create Invoice</button>
}

<a href="/showall"><button class="btn-warn mt-3">Back</button></a>

@if (createdInvoice)
{
    <div class="mt-3">
        <ToasterComponent Message="Invoice created!" Type="success" Redirect="true" Location="invoices" Url="showall" />
    </div>
}
@if (accountNotSelected)
{
    <div class="mt-3">
        <ToasterComponent Message="No bank account selected, please select or make one." Type="danger" Redirect="true" Location="Mange user" Url="user" />
    </div>
}

@code {
    private bool createdInvoice = false;
    private InvoiceService invoiceService = new InvoiceService();
    private Invoice newInvoice = new Invoice();
    private List<Item> invoiceItems = new List<Item>();

    private List<SKU> skuOptions = new List<SKU>();
    private SKUService skuService = new SKUService(); 

    private UserService userService = new UserService();
    private User currentUser = new User();

    private ClientService clientService = new ClientService();
    private List<ClientNameSetDTO> clientOptions = new List<ClientNameSetDTO>();

    private bool accountNotSelected = false;
    private BankAccountService bankAccountService = new BankAccountService();
    private List<BankAccount> bankAccounts = new List<BankAccount>();
    private BankAccount selectedAccount = new BankAccount();

    private int selectedSkuId = 0; 
    private int invoiceNumber = 0; 

    protected override void OnInitialized()
    {
        currentUser = userService.dbLoadUser();
        skuOptions = skuService.dbGetMany(currentUser.UserId, skuService.dbGetCount(currentUser.UserId), 0); 
        bankAccounts = bankAccountService.dbGetAccounts();
        newInvoice.UserId = currentUser.UserId;
        newInvoice.StartDate = DateTime.Now;
        newInvoice.EndDate = DateTime.Now;
        newInvoice.PaymentDate = DateTime.Now;
        newInvoice.CreatedDate = DateTime.Now;
        clientOptions = clientService.dbGetClientNames(currentUser.UserId);
    }

    private void AddItem()
    {
        invoiceItems.Add(new Item());
    }

    private void RemoveItem(Item item)
    {
        invoiceItems.Remove(item);
    }

    private void OnSkuSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out selectedSkuId))
        {
            SKU currentSKU = skuService.dbGetSingle(currentUser.UserId, selectedSkuId);
            invoiceNumber = skuService.newestNum(currentUser.UserId, currentSKU.Id) + 1; 

            newInvoice.skuTypeId = selectedSkuId;
            if (invoiceNumber < 100)
            {
                currentSKU.SKUName += "0";
            }
            if (invoiceNumber < 10)
            {
                currentSKU.SKUName += "0";
            }
            newInvoice.InvoiceNum = currentSKU.SKUName + invoiceNumber;
        }
    }

    private void SaveInvoice()
    {

        newInvoice.UserId = currentUser.UserId;
        Client selectedClient = clientService.dbGetSingle(currentUser.UserId, newInvoice.ClientId);
        if (selectedClient.isB2B == true)
        {
            newInvoice.ClientName = selectedClient.BusinessName;
        }
        else
        {
            newInvoice.ClientName = selectedClient.FirstName + " " + selectedClient.LastName;
        }


        try
        {
            if (bankAccountService.dbGetAccount(selectedAccount.AccountId) != null)
            {
                newInvoice.BankAccountId = selectedAccount.AccountId;
                invoiceService.dbCreateInvoice(newInvoice, invoiceItems);
                accountNotSelected = false;
                createdInvoice = true;                
            }
            else
            {
                accountNotSelected = true;
            }
        }
        catch
        {
            
        }


    }
}
